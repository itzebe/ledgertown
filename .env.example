# Ledgertown environment variables (all optional).
# These are read from the process environment; the project does not load `.env`
# automatically — export them, or use a runner that does.
#
# No secrets belong in a committed file. In play mode the demo key is supplied
# through the host's secret store (e.g. Vercel Project → Settings → Environment
# Variables), never git.

# --- RPC / contract ---------------------------------------------------------
# First testnet RPC endpoint to try (comma-separated list = automatic failover).
LEDGERTOWN_RPC=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org,https://rpc.testnet.near.org
# Contract account to talk to. Default: town.ledgertown.testnet
LEDGERTOWN_CONTRACT=town.ledgertown.testnet

# --- server -----------------------------------------------------------------
# Bind address/port. A host that injects PORT (e.g. Vercel) expects 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# "read-only" (default, no keys, safe to expose) or "play" (bounded actions).
LEDGERTOWN_MODE=read-only

# CORS allowlist, comma-separated. Empty = same-origin only.
LEDGERTOWN_ALLOW_ORIGIN=

# --- play mode only (NEVER commit real values) ------------------------------
# A dedicated, low-balance testnet account. deposit() and all owner-only methods
# remain unreachable regardless of these values.
LEDGERTOWN_DEMO_ACCOUNT=
LEDGERTOWN_DEMO_KEY=
