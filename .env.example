# Ledgertown optional environment variables.
# Copy to `.env` and fill in only if you want to override the defaults.
# These are read from the process environment; the project does not load `.env`
# automatically — export them, or use a runner that does.
#
# No secrets belong here. Real signing keys live in keys/identities.json
# (git-ignored, created by `node driver/keys.js`).

# First testnet RPC endpoint to try (others are used as automatic fallbacks).
LEDGERTOWN_RPC=https://free.rpc.fastnear.com

# Contract account to talk to. Default: town.ledgertown.testnet
LEDGERTOWN_CONTRACT=town.ledgertown.testnet

# Play server bind address. Defaults to loopback; the server has NO auth and
# signs with the local testnet keys, so only widen this deliberately.
HOST=127.0.0.1
PORT=3000
